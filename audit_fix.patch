-        trend_strength = min(100, int((lh_count + ll_count) / max(1, lookback * 2) * 100))
-    else:
-        trend = "sideways"
-        trend_strength = 30
-
-    # SMA-Bestätigung
-    if closes[-1] > sma5 > sma10 > sma20:
