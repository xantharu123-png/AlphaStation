+                        degen_score += 30
+                    elif change_7d >= 50:
+                        degen_score += 25
+                    else:
+                        degen_score += 15
+
+                    if vol_mcap_ratio > 50:
+                        degen_score += 25
+                    elif vol_mcap_ratio > 20:
+                        degen_score += 15
+                    else:
+                        degen_score += 5
+
+                    if mcap < 5_000_000:
+                        degen_score += 25
+                    elif mcap < 15_000_000:
+                        degen_score += 20
+                    else:
+                        degen_score += 10
+
+                    if has_perp:
