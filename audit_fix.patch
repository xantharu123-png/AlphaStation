-            hh_count += 1
-        else:
-            lh_count += 1
-        if lows[i] > lows[i - 1]:
-            hl_count += 1
-        else:
-            ll_count += 1
-
-    if hh_count >= lookback * 0.6 and hl_count >= lookback * 0.6:
