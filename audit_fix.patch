+                if (response.ok) {
+                    const data = await response.json();
+                    // API returns strategies as {name: config} dict — extract keys as array
+                    const strats = data.strategies || {};
+                    setStrategies(typeof strats === 'object' && !Array.isArray(strats) ? Object.keys(strats) : (Array.isArray(strats) ? strats : []));
