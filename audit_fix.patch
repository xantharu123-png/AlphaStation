+
+        # Reverse to chronological
+        bars = list(reversed(bars))
+        closes = [b["c"] for b in bars]
+        dates = [datetime.fromtimestamp(b["t"] / 1000).strftime("%Y-%m-%d") for b in bars]
+
+        trades = []
+        position = None  # None = no position, dict = open position
+
