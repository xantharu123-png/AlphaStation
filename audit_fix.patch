-            trend_strength = 50
-
-    # =====================================================
-    # 3. SUPPORT / RESISTANCE
-    # =====================================================
-    recent_lows = sorted(lows[-15:])[:3] if n >= 15 else sorted(lows)[:3]
-    recent_highs = sorted(highs[-15:], reverse=True)[:3] if n >= 15 else sorted(highs, reverse=True)[:3]
