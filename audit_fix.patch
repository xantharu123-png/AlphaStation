+            oi_usdt = hold_vol * last_price if last_price > 0 else hold_vol
+            vol_usdt = volume24 * last_price if last_price > 0 else volume24
+            oi_ratio = (oi_usdt / vol_usdt) if vol_usdt > 0 else 0
+            result[base] = {
+                "funding_rate": fr,
+                "hold_vol": hold_vol,
+                "volume24": vol_usdt,
+                "oi_usdt": oi_usdt,
+                "oi_ratio": round(oi_ratio, 2),
