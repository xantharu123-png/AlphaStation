+                    
+                    pdh = cand.get("pdh", 0)
+                    pdl = cand.get("pdl", 0)
+                    
+                    # Fibonacci der PM Range
+                    fib_382 = pm_low + pm_range * 0.382
+                    fib_500 = pm_low + pm_range * 0.500
+                    fib_618 = pm_low + pm_range * 0.618
