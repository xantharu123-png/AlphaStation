+                    dist_to_low = ((current_price - pm_low) / pm_low) * 100 if pm_low > 0 else 0
+                    
+                    # Relative Strength vs SPY
+                    rs_vs_spy = cand.get("pm_change", 0) - spy_pm_change
+                    
+                    # ATR% Schätzung (PM Range / Preis)
