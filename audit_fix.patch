+            bars_below_or = sum(1 for b in post_or if b["c"] < or_low)
+
+            # Auch den aktuellen Preis aus Grouped Daily nutzen (robuster als nur 5-Min Bars)
+            _daily_price = cand.get("current", 0) or current_price
