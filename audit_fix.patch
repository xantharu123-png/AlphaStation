-def _serialize_json(obj):
-    """Handle NaN, Infinity and other non-JSON-serializable types."""
-    if isinstance(obj, float):
-        if math.isnan(obj):
-            return None
-        if math.isinf(obj):
-            return None
-    raise TypeError(f"Object of type {type(obj)} is not JSON serializable")
