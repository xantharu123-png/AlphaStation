+        for t in tickers:
+            try:
+                # =====================================================
+                # AKTIEN FILTER - Nur echte Aktien (Common Stock)
+                # =====================================================
+                ticker_symbol = t.get("ticker", "")
+                
+                if exclude_etfs:
+                    # Methode 1: Prüfe ob in Common Stock Liste
