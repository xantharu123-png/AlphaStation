+                low_i = lows[i]
+                prev_close_i = closes[i + 1] if i < len(closes) - 1 else closes[i]
+                tr = max(high_i - low_i, abs(high_i - prev_close_i), abs(low_i - prev_close_i))
+                tr_values.append(tr)
