+            } catch (err) {
+                console.error('Error:', err);
+            } finally {
+                setLoading(false);
+            }
+        };
+        fetchStrategies();
+    }, [activeMarket]);
+
+    const marketTypes = [
+        { id: 'stocks', label: 'Aktien' },
+        { id: 'crypto', label: 'Crypto' },
+        { id: 'futures', label: 'Futures' },
+        { id: 'forex', label: 'Forex' }
