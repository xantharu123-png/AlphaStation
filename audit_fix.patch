+
+            # 2. MICRO-CAP MOMENTUM
+            _micro_vol_min = 750_000 if change_7d >= 20 else 500_000
+            if 1_000_000 <= mcap <= 50_000_000 and vol_24h > _micro_vol_min:
+                if change_7d > 5 and change_24h > -10:
+                    degen_score = 0
