+                except Exception as e:
+                    print(f"Harmonic error: {e}")
+
+                # Chart patterns (Double Top/Bottom, H&S, Triangles)
+                try:
+                    chart_pats = detect_chart_patterns(ohlcv)
+                    if chart_pats:
+                        patterns_result["chart_patterns"] = chart_pats[:5]
+                except Exception as e:
