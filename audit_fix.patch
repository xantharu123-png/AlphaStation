-                "cached_at": datetime.now().isoformat(),
-                "results": data,
-            }
-            with open(filepath, "w") as f:
-                json.dump(cache_data, f, indent=2, default=_serialize_json)
-        except Exception as e:
-            print(f"Error saving cache {filepath}: {e}")
