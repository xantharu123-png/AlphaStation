+        # Bear Flag Retracement: Bounce von gestern Low zu heute High
+        flagpole = 0
+        if prev_high > 0 and prev_low > 0:
+            flagpole = prev_high - prev_low
+
+        if flagpole <= 0 and prev_close > 0 and vortag_chg < 0:
