+                # ── MACD (12/26 EMA Differenz) ──
+                def _ema(data, period):
+                    if len(data) < period:
+                        return sum(data) / len(data)
+                    mult = 2 / (period + 1)
+                    ema_val = sum(data[:period]) / period
+                    for p in data[period:]:
+                        ema_val = (p - ema_val) * mult + ema_val
+                    return ema_val
+                # MACD: Berechne MACD-Linie für die letzten 35 Bars
