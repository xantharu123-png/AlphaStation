-            elif close_pos >= 0.65:
-                candle_score += 10
-            elif close_pos >= 0.50:
-                candle_score += 5
-
-            # Bonus: Wenig Upper Wick = kein Rejection von oben
-            if upper_wick_pct is not None:
-                if upper_wick_pct < 15:
-                    candle_score += 6
-                elif upper_wick_pct < 25:
