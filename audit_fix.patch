+        emoji = "[!]"
+        risk = "Überdehnt - Reversal möglich"
+        recommendation = "Auf Bestätigung warten"
+    else:
+        rating = "ZU FRÜH"
+        emoji = "[X]"
+        risk = "Nicht genug überdehnt"
+        recommendation = "Warten auf stärkere Überdehnung"
+    
+    return {
