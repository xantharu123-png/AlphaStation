+        # Kriterium 1: Trading Range vorhanden (max 25)
+        if total_range_pct < 15:
+            score += 25
+            details.append(f"Trading Range: {total_range_pct:.1f}% ueber {n} Tage")
+        elif total_range_pct < 25:
+            score += 15
+            details.append(f"Weite Range: {total_range_pct:.1f}%")
