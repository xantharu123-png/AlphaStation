-                    _high_sev = [w for w in warnings if w["severity"] == "high"]
-                    warnings = _high_sev[:1] if _high_sev else warnings[:1]
-
-        # Max 2 Patterns — mehr verwirrt nur
-        warnings = warnings[:2]
-
-    return warnings
