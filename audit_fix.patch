+                    params={"adjusted": "true", "sort": "asc", "apiKey": poly_key}, timeout=10)
+                if vr.status_code == 200:
+                    vb = vr.json().get("results", [])
+                    if vb and len(vb) >= 10:
+                        vc = vb[-1]["c"]; va20 = sum(b["c"] for b in vb[-20:])/20
+                        spike = vc/max(0.01, va20)
