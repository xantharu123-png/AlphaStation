+                    timing = "🟡 BEREIT — Warte auf Bounce Richtung High für besseren Entry"
+                elif exh_score >= 50 and price_mid_range and change_1h < 0:
+                    timing = "🟠 WATCHLIST — Mittlerer Bereich, könnte noch bounzen"
