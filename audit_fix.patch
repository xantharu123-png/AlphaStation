+def _save_watchlist():
+    """Speichert Watchlist als JSON (überlebt App-Reruns)."""
+    try:
+        import json
+        # Entferne nicht-serialisierbare Daten
+        clean = []
+        for w in st.session_state.watchlist:
+            clean.append({
+                "ticker": w["ticker"],
+                "market": w.get("market", ""),
+                "price": w.get("price", 0),
+                "added": w.get("added", ""),
+            })
+        with open(_watchlist_file(), "w") as f:
+            json.dump(clean, f)
+    except Exception as e:
+        pass
