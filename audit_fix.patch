+DEFAULT_CRYPTO_COINS = [
+    # Mega Cap (Top 5 by Market Cap)
+    "BTC", "ETH", "BNB", "SOL", "XRP",
+    # Large Cap (Top 6-15)
+    "ADA", "DOGE", "TRX", "TON", "LINK",
