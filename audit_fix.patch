+        # Polygon Starter: ~100 Calls/Min → 0.15s zwischen Calls
+        if i % 10 == 9:
+            time.sleep(1.5)  # 10 Calls in ~1.5s + 1.5s Pause = ~80/Min
+    results.sort(key=lambda x: x["score"], reverse=True)
