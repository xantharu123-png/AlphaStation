# Alpha Station — FastAPI Backend (das kommerzielle Produkt)
# Ersetzt die alte Unit "tradingbot.service" (Streamlit), siehe Audit LB-3.
# Install: sudo cp deploy/tradingbot-api.service /etc/systemd/system/ && sudo systemctl daemon-reload

[Unit]
Description=Alpha Station API (FastAPI/uvicorn auf 127.0.0.1:8000)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tradingbot
Group=tradingbot
WorkingDirectory=/home/tradingbot/app

# Pflicht-ENVs (JWT_SECRET, COMMERCE_ENFORCE_AUTH, Stripe, ...) — Vorlage:
# .env.production.example; install.sh legt die Datei an. Das "-" vor dem Pfad:
# fehlende .env blockiert den systemd-Start nicht (ENV kann auch per Drop-in
# kommen). Fail-closed erzwingt die App selbst: im Commercial-Mode bricht sie
# beim Boot mit RuntimeError ab, wenn Default-Secrets/Legacy-Keys aktiv sind.
EnvironmentFile=-/home/tradingbot/app/.env
Environment="PATH=/home/tradingbot/app/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="API_BIND_HOST=127.0.0.1"
Environment="HOME=/var/lib/alpha-station-runtime"
Environment="XDG_CACHE_HOME=/var/lib/alpha-station-runtime/cache"

# Nur an localhost binden — TLS-Terminierung und Frontend-Auslieferung macht nginx.
ExecStart=/home/tradingbot/app/venv/bin/uvicorn api:app --host ${API_BIND_HOST} --port 8000

Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tradingbot-api

# Limits
LimitNOFILE=65536

# ── Hardening ──
NoNewPrivileges=true
# Der gesamte Host inklusive Quellbaum und venv ist read-only. Ausschliesslich
# persistenter/runtime Zustand unter data_cache darf der Service schreiben.
ProtectSystem=strict
ReadWritePaths=/home/tradingbot/app/data_cache
# systemd erstellt diesen persistenten Zustand unter dem root-kontrollierten
# /var/lib-Parent. Der Service kann den Bind-Quellpfad daher nicht austauschen.
StateDirectory=alpha-station-runtime
StateDirectoryMode=0700
# ProtectHome NICHT setzen - die App liegt unter /home/tradingbot/app.
# Beide Dienste sehen dasselbe persistente StateDirectory als /tmp. Damit
# bleiben bestehende Cache-Pfade kompatibel, ohne einen service-austauschbaren
# Bind-Quellpfad oder das globale Server-/tmp zu verwenden.
PrivateTmp=true
BindPaths=/var/lib/alpha-station-runtime:/tmp
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
