[Unit]
Description=TradingBot Background Scanner Service
After=network.target

[Service]
Type=simple
User=tradingbot
Group=tradingbot
WorkingDirectory=/home/tradingbot/app
Environment="PATH=/home/tradingbot/app/venv/bin:/usr/bin"
ExecStart=/home/tradingbot/app/venv/bin/python bg_service.py
Restart=always
RestartSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tradingbot-bg

[Install]
WantedBy=multi-user.target
