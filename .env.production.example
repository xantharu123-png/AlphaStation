# Alpha Station production environment template
# Copy values into /home/tradingbot/app/.env on the server. Do not commit real secrets.

# Public app URL must be HTTPS for paid launch.
PUBLIC_APP_URL=https://your-domain.example
CORS_ORIGINS=https://your-domain.example

# Commercial API paywall. Keep this enabled for any paid/beta customer access.
COMMERCE_ENFORCE_AUTH=1
COMMERCIAL_STRICT_MODE=1
# Coupon grants use a separate compatibility store and must stay disabled
# until redemption and account access share one database transaction.
ENABLE_COUPONS=0

# Human launch approvals. Set to 1 only after the respective review is complete.
LEGAL_REVIEW_APPROVED=0
DATA_LICENSE_APPROVED=0
TAX_SETUP_APPROVED=0
# Repository history previously contained production-like credentials. These
# flags may only be enabled after every exposed provider/auth key was rotated
# and repository visibility/collaborator access was reviewed.
HISTORICAL_SECRETS_ROTATED=0
SOURCE_REPOSITORY_ACCESS_REVIEWED=0
LEGAL_ENTITY_NAME=replace_with_registered_entity_or_business_name
LEGAL_OPERATOR_NAME=replace_with_responsible_operator_name
LEGAL_POSTAL_ADDRESS=replace_with_full_street_postcode_city_country
LEGAL_CONTACT_EMAIL=legal@example.com
LEGAL_TERMS_VERSION=2026-01-01
LEGAL_PRIVACY_VERSION=2026-01-01

# Auth hardening. Generate long random values; do not use defaults.
# JWT_SECRET must be 64 hex chars: generate with  openssl rand -hex 32
JWT_SECRET=replace_with_output_of__openssl_rand_-hex_32
JWT_EXPIRY_HOURS=24
ADMIN_MASTER_KEY=replace-with-long-random-admin-bootstrap-secret
ALLOW_LEGACY_ADMIN_MASTER_KEY=0
ADMIN_EMAILS=your-admin-email@example.com

# Stripe live mode. Use live keys/products for paid launch.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_TRIAL=price_replace_live_trial
STRIPE_PRICE_BASIC=price_replace_live_basic
STRIPE_PRICE_PRO=price_replace_live_pro
STRIPE_PRICE_ELITE=price_replace_live_elite

# Market/data providers. Confirm commercial redistribution rights before public sale.
POLYGON_KEY=replace_me
BPIQ_API_KEY=replace_me
ANTHROPIC_API_KEY=replace_me
FINNHUB_KEY=replace_me

# Background scanner (bg_service.py).
# BG_SCAN_SET selects which scheduled scan set the background service runs.
# BG_POLYGON_BUDGET_PER_MIN caps Polygon API calls per minute so background
# scans cannot starve interactive API requests of provider budget.
BG_SCAN_SET=default
ALLOW_DUPLICATE_SCAN_OWNERSHIP=0
API_SCAN_SKIP_BG_OWNED=1
BG_POLYGON_BUDGET_PER_MIN=100

# Email alerts. Use an app password, not your normal Gmail password.
GMAIL_USER=alerts@example.com
GMAIL_APP_PASSWORD=replace_me
ALERT_EMAIL=owner-fallback@example.com
ALERT_SEND_TO_SUBSCRIBERS=1
ALERT_OPERATOR_WATCH_OPTIN=0

# Telegram (optional): 🚨-trade alerts are mirrored to Telegram in addition to email.
# Setup: chat with @BotFather -> /newbot -> copy token; get your chat id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Signal tracker (optional): SQLite path for alert performance tracking.
# Default: data_cache/signal_tracker.sqlite
SIGNAL_TRACKER_DB_PATH=

# Runtime data. Keep this persistent and backed up.
ALPHA_DATA_DIR=/home/tradingbot/app/data_cache
AUTH_DB_PATH=/home/tradingbot/app/data_cache/auth/alpha_station_auth.sqlite
